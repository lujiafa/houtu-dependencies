<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.houtu</groupId>
    <artifactId>houtu-dependencies</artifactId>
    <version>3.5.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <skipTests>true</skipTests>
        <spring-boot-starter-parent.version>3.5.0</spring-boot-starter-parent.version>
        <jakarta.xml.bind-api.version>4.0.2</jakarta.xml.bind-api.version>
        <com.houtu.version>3.5.1-SNAPSHOT</com.houtu.version>
    </properties>

    <modules>
        <module>houtu-core</module>
        <module>houtu-utils</module>
        <module>houtu-access-log</module>
        <module>houtu-web</module>
        <module>houtu-web-security</module>
        <module>spring-cloud-houtu</module>
        <module>houtu-data-security</module>
    </modules>

    <dependencyManagement>
        <!-- 公共功能模块引入pom依赖 -->
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-parent</artifactId>
                <version>${spring-boot-starter-parent.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>com.houtu</groupId>
                <artifactId>houtu-utils</artifactId>
                <version>${com.houtu.version}</version>
            </dependency>
            <dependency>
                <groupId>com.houtu</groupId>
                <artifactId>houtu-core</artifactId>
                <version>${com.houtu.version}</version>
            </dependency>
            <dependency>
                <groupId>com.houtu</groupId>
                <artifactId>houtu-access-log</artifactId>
                <version>${com.houtu.version}</version>
            </dependency>
            <dependency>
                <groupId>com.houtu</groupId>
                <artifactId>houtu-data-security</artifactId>
                <version>${com.houtu.version}</version>
            </dependency>
            <dependency>
                <groupId>com.houtu</groupId>
                <artifactId>houtu-web</artifactId>
                <version>${com.houtu.version}</version>
            </dependency>
            <dependency>
                <groupId>com.houtu</groupId>
                <artifactId>houtu-web-security</artifactId>
                <version>${com.houtu.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                        <encoding>${project.build.sourceEncoding}</encoding>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <developers>
        <developer>
            <id>jon</id>
            <name>Jon Lu</name>
            <email>lujiafayx@163.com</email>
            <roles>
                <role>Project lead</role>
            </roles>
        </developer>
    </developers>

</project>
